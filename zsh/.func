# ~/.func — 工具函数,由 ~/.zshrc 自动 source

# ---- proxy ----
setproxy() {
  local p="http://localhost:7890"
  export http_proxy=$p https_proxy=$p all_proxy=$p \
         HTTP_PROXY=$p HTTPS_PROXY=$p ALL_PROXY=$p \
         NO_PROXY="localhost,127.0.0.1"
}

initproxy() {
  unset http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY NO_PROXY
}

# ---- env ----
set_claude_env() {
  export ANTHROPIC_BASE_URL="https://<YOUR_GATEWAY_HOST>/claude"
  export ANTHROPIC_AUTH_TOKEN="<YOUR_ANTHROPIC_AUTH_TOKEN>"
  unset ANTHROPIC_DEFAULT_OPUS_MODEL ANTHROPIC_DEFAULT_SONNET_MODEL ANTHROPIC_DEFAULT_HAIKU_MODEL
}

# ---- search / process / port ----
search_file() {
  [ $# -lt 2 ] && { echo "Usage: search_file <dir> <term> [exclude_dir...]"; return 1; }
  local dir="$1" term="$2"; shift 2
  local excl=() d
  for d in "$@"; do excl+=(-not -path "*/$d/*"); done
  find "$dir" -type f "${excl[@]}" | grep "$term" | xargs -r -d '\n' du -h
}

mykill() {
  local p
  p=$(pgrep -f "$1") && kill -9 $p
}

find_process() {
  [ -z "$1" ] && { echo "Usage: find_process <pattern>"; return 1; }
  pgrep -af "$1"
}

check_port() {
  [ -z "$1" ] && { echo "Usage: check_port <port>"; return 1; }
  local pids p
  pids=$(sudo ss -tulnp | grep ":$1 " | grep -o 'pid=[0-9]*' | cut -d= -f2 | sort -u)
  [ -z "$pids" ] && { echo "no process listening on port $1"; return 0; }
  for p in $pids; do ps -p "$p" -o pid=,user=,etime=,cmd=; done
}

# ---- wait ----
wait_on_command() {
  if [ $# -lt 1 ] || [ $# -gt 2 ]; then echo "Usage: wait_on_command <keyword> [start_command]"; return 1; fi
  if ! pgrep -f "$1" >/dev/null; then
    [ -z "$2" ] && { echo "not running: $1"; return 0; }
    eval "$2" &
    sleep 3
  fi
  while pgrep -f "$1" >/dev/null; do
    echo "$(date '+%F %T') still running: $1"
    sleep 60
  done
  echo "$(date '+%F %T') done: $1"
}

# ---- kde ----
# kde_refresh [1|2|3]: 1=合成器 suspend/resume(最安全) 2=kwin --replace 3=再加 plasmashell(2/3 可能崩 Electron)
kde_refresh() {
  local l="${1:-1}" kwin a
  case "$l" in
    1)
      qdbus org.kde.KWin /Compositor suspend && sleep 0.8 && qdbus org.kde.KWin /Compositor resume \
        || qdbus org.kde.KWin /KWin reconfigure
      ;;
    2|3)
      pgrep -x 'code|electron|siyuan|notion|obsidian|slack|discord' >/dev/null && {
        echo "Electron 应用在运行,Level $l 可能使其崩溃,继续?[y/N]"
        read -r a
        [[ "$a" =~ ^[yY]$ ]] || return 1
      }
      kwin=kwin_x11
      systemctl --user is-active --quiet plasma-kwin_wayland.service && kwin=kwin_wayland
      "$kwin" --replace >/dev/null 2>&1 &
      [ "$l" = 3 ] && { sleep 2; plasmashell --replace >/dev/null 2>&1 & }
      ;;
    *) echo "Usage: kde_refresh [1|2|3]"; return 1 ;;
  esac
}
