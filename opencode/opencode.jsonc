{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "permission": "allow",
  "compaction": { "auto": false, "prune": false },
  "provider": {
    "claude-newapi": {
      "npm": "@ai-sdk/anthropic",
      "options": {
        "baseURL": "https://<YOUR_GATEWAY_HOST>/v1",
        "apiKey": "<YOUR_NEWAPI_API_KEY>"
      },
      "models": {
        "claude-opus-5": {
          "name": "Claude Opus 5",
          "limit": {
            "context": 1000000,
            "input": 900000,
            "output": 100000
          },
          "variants": {
            "low": {
              "thinking": { "type": "adaptive" },
              "effort": "low"
            },
            "max": {
              "thinking": { "type": "adaptive", "display": "summarized" },
              "effort": "max"
            }
          }
        },
      }
    },
    "codex-newapi": {
      "npm": "@ai-sdk/openai",
      "options": {
        "baseURL": "https://<YOUR_GATEWAY_HOST>/v1",
        "apiKey": "<YOUR_NEWAPI_API_KEY>",
        "setCacheKey": true,
      },
      "models": {
        "gpt-5.5": {
          "name": "GPT 5.5",
          "limit": {
            "context": 400000,
            "input": 272000,
            "output": 32000
          },
          "options": {
            "store": false
          },
          "variants": {
            "low": {"reasoningEffort": "low"},
            "medium": {"reasoningEffort": "medium"},
            "high": {"reasoningEffort": "high"},
            "xhigh": {"reasoningEffort": "xhigh"},
          }
        },
        "gpt-5.6-sol": {
          "name": "GPT 5.6 Sol",
          "limit": {
            "context": 500000,
            "input": 372000,
            "output": 128000
          },
          "options": {
            "store": false
          },
          "variants": {
            "low": {"reasoningEffort": "low"},
            "medium": {"reasoningEffort": "medium"},
            "high": {"reasoningEffort": "high"},
            "xhigh": {"reasoningEffort": "xhigh"},
          }
        },
        "gpt-5.6-luna": {
          "name": "GPT 5.6 Luna",
          "limit": {
            "context": 500000,
            "input": 372000,
            "output": 128000
          },
          "options": {
            "store": false
          },
          "variants": {
            "max": {"reasoningEffort": "max"},
          }
        },
      }
    },
    "anthropic-newapi": {
      "npm": "@ai-sdk/anthropic",
      "options": {
        "baseURL": "https://<YOUR_GATEWAY_HOST>/v1",
        "apiKey": "<YOUR_NEWAPI_API_KEY>"
      },
      "models": {
        "minimax-latest": {
          "name": "minimax latest",
          "limit": {
            "context": 1000000,
            "input": 900000,
            "output": 100000
          },
          "variants": {
            "low": {
              "thinking": { "type": "adaptive" },
              "effort": "low"
            },
            "max": {
              "thinking": { "type": "adaptive", "display": "summarized" },
              "effort": "max"
            }
          }
        },
        "kimi-latest": {
          "name": "kimi latest",
          "limit": {
            "context": 1000000,
            "input": 600000,
            "output": 400000
          },
          "variants": {
            "low": {
              "thinking": { "type": "adaptive" },
              "effort": "low"
            },
            "max": {
              "thinking": { "type": "adaptive", "display": "summarized" },
              "effort": "max"
            }
          }
        },
        "deepseek-v4-pro": {
          "name": "deepseek v4 pro",
          "limit": {
            "context": 1000000,
            "input": 900000,
            "output": 100000
          },
          "variants": {
            "low": {
              "thinking": { "type": "adaptive" },
              "effort": "low"
            },
            "max": {
              "thinking": { "type": "adaptive", "display": "summarized" },
              "effort": "max"
            }
          }
        },
        "deepseek-v4-flash": {
          "name": "deepseek v4 flash",
          "limit": {
            "context": 1000000,
            "input": 900000,
            "output": 100000
          },
          "variants": {
            "low": {
              "thinking": { "type": "adaptive" },
              "effort": "low"
            },
            "max": {
              "thinking": { "type": "adaptive", "display": "summarized" },
              "effort": "max"
            }
          }
        },
      },
    }
  },
  "agent": {
    "explore": {
      "model": "anthropic-newapi/deepseek-v4-flash",
      "tools": {
        "read": true,
        "grep": true,
        "glob": true,
        "write": false,
        "edit": false,
      }
    },
    "general": {
      "model": "codex-newapi/gpt-5.6-luna",
      "tools": {
        "read": true,
        "grep": true,
        "glob": true,
        "write": true,
        "edit": true,
      }
    }
  },
  "mcp": {
    "mcphub-web": {
      "type": "remote",
      "url": "https://mcp.pezayo.com/mcp/web"
    },
    // claude-mem 的 MCP 条目不在此配置:由 opencode-setup.sh 按各机器家目录动态写入 opencode.json
  },
  "snapshot": false,
  "plugin": [
    "@cortexkit/opencode-magic-context@latest",
    "@dietrichgebert/ponytail",
    "./plugins/claude-mem-wrapper.js"
  ]
}
