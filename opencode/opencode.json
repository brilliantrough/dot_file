{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "permissions": [
    { "action": "*", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "deny" },
    { "action": "websearch", "resource": "*", "effect": "deny" }
  ],
  "compaction": {
    "auto": false
  },
  "providers": {
    "claude-newapi": {
      "package": "aisdk:@ai-sdk/anthropic",
      "settings": {
        "baseURL": "https://<YOUR_GATEWAY_HOST>/v1",
        "apiKey": "<YOUR_NEWAPI_API_KEY>"
      },
      "models": {
        "claude-opus-5-5": {
          "name": "Claude Opus 5.5",
          "limit": {
            "context": 500000,
            "input": 372000,
            "output": 128000
          },
          "variants": [
            { "id": "low", "settings": {
              "thinking": {
                "type": "adaptive"
              },
              "effort": "low"
            } },
            { "id": "max", "settings": {
              "thinking": {
                "type": "adaptive",
                "display": "summarized"
              },
              "effort": "max"
            } }
          ]
        }
      }
    },
    "codex-newapi": {
      "package": "aisdk:@ai-sdk/openai",
      "compatibility": { "supportsPromptCacheKey": true },
      "settings": {
        "baseURL": "https://<YOUR_GATEWAY_HOST>/v1",
        "apiKey": "<YOUR_NEWAPI_API_KEY>"
      },
      "models": {
        "gpt-6-astra": {
          "name": "GPT 6 Astra",
          "limit": {
            "context": 500000,
            "input": 372000,
            "output": 128000
          },
          "settings": {
            "store": false
          },
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } },
            { "id": "max", "settings": { "reasoningEffort": "max" } }
          ]
        },
        "gpt-6.1-sol": {
          "name": "GPT 6.1 Sol",
          "limit": {
            "context": 500000,
            "input": 372000,
            "output": 128000
          },
          "settings": {
            "store": false
          },
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } },
            { "id": "max", "settings": { "reasoningEffort": "max" } }
          ]
        },
        "gpt-6-luna": {
          "name": "GPT 6 Luna",
          "limit": {
            "context": 500000,
            "input": 372000,
            "output": 128000
          },
          "settings": {
            "store": false
          },
          "variants": [
            { "id": "max", "settings": { "reasoningEffort": "max" } }
          ]
        }
      }
    },
    "anthropic-newapi": {
      "package": "aisdk:@ai-sdk/anthropic",
      "settings": {
        "baseURL": "https://<YOUR_GATEWAY_HOST>/v1",
        "apiKey": "<YOUR_NEWAPI_API_KEY>"
      },
      "models": {
        "minimax-latest": {
          "name": "minimax latest",
          "limit": {
            "context": 1000000,
            "input": 900000,
            "output": 100000
          },
          "variants": [
            { "id": "low", "settings": {
              "thinking": {
                "type": "adaptive"
              },
              "effort": "low"
            } },
            { "id": "max", "settings": {
              "thinking": {
                "type": "adaptive",
                "display": "summarized"
              },
              "effort": "max"
            } }
          ]
        },
        "kimi-latest": {
          "name": "kimi latest",
          "limit": {
            "context": 500000,
            "input": 372000,
            "output": 128000
