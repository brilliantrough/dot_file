            { "id": "max", "settings": {
              "thinking": {
                "type": "enabled",
                "display": "summarized",
                "budgetTokens": 32000
              },
              "effort": "max"
            } }
          ]
        },
        "grok-4.7": {
          "name": "Grok 4.7",
          "limit": {
            "context": 500000,
            "input": 372000,
            "output": 128000
          },
          "variants": [
            { "id": "low", "settings": {
              "thinking": {
                "type": "enabled",
                "budgetTokens": 8000
              },
              "effort": "low"
            } },
            { "id": "high", "settings": {
              "thinking": {
                "type": "enabled",
                "display": "summarized",
                "budgetTokens": 16000
              },
              "effort": "high"
            } },
            { "id": "max", "settings": {
              "thinking": {
                "type": "enabled",
                "display": "summarized",
                "budgetTokens": 32000
              },
              "effort": "max"
            } }
          ]
        },
        "mem-1": {
          "name": "mem-1",
          "limit": {
            "context": 500000,
            "input": 372000,
            "output": 128000
          },
          "variants": [
            { "id": "medium", "settings": {
              "thinking": {
                "type": "enabled",
                "budgetTokens": 12000
              },
              "effort": "medium"
            } },
            { "id": "high", "settings": {
              "thinking": {
                "type": "adaptive"
              },
              "effort": "high"
            } }
          ]
        }
      }
    },
    "gemini-newapi": {
      "package": "aisdk:@ai-sdk/google",
      "settings": {
        "baseURL": "https://<YOUR_GATEWAY_HOST>/v1beta",
        "apiKey": "<YOUR_NEWAPI_API_KEY>"
      },
      "models": {
        "gemini-4-argon": {
          "name": "Gemini 4 Argon",
          "limit": {
            "context": 500000,
            "input": 372000,
            "output": 128000
          }
        }
      }
    },
    "zhipuai-coding-plan": {
      "models": {
        "glm-4.6v": {
          "limit": {
            "context": 500000,
            "output": 32768
          }
        },
        "glm-5.3": {
          "limit": {
            "context": 500000,
            "output": 131072
          }
        },
        "glm-5.3-flash": {
          "limit": {
            "context": 500000,
            "output": 131072
          }
        },
        "glm-5.3-highspeed": {
          "limit": {
            "context": 500000,
