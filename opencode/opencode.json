{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "permission": {
    "*": "allow",
    "webfetch": "deny",
    "websearch": "deny"
  },
  "compaction": {
    "auto": false,
    "prune": false
  },
  "provider": {
    "claude-newapi": {
      "npm": "@ai-sdk/anthropic",
      "options": {
        "baseURL": "https://<YOUR_GATEWAY_HOST>/v1",
        "apiKey": "<YOUR_NEWAPI_API_KEY>"
      },
      "models": {
        "claude-opus-5-5": {
          "name": "Claude Opus 5.5",
          "limit": {
            "context": 1000000,
            "input": 900000,
            "output": 100000
          },
          "variants": {
            "low": {
              "thinking": {
                "type": "adaptive"
              },
              "effort": "low"
            },
            "max": {
              "thinking": {
                "type": "adaptive",
                "display": "summarized"
              },
              "effort": "max"
            }
          }
        }
      }
    },
    "codex-newapi": {
      "npm": "@ai-sdk/openai",
      "options": {
        "baseURL": "https://<YOUR_GATEWAY_HOST>/v1",
        "apiKey": "<YOUR_NEWAPI_API_KEY>",
        "setCacheKey": true
      },
      "models": {
        "gpt-6-astra": {
          "name": "GPT 6 Astra",
          "limit": {
            "context": 500000,
            "input": 372000,
            "output": 128000
          },
          "options": {
            "store": false
          },
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            }
          }
        },
        "gpt-6.1-sol": {
          "name": "GPT 6.1 Sol",
          "limit": {
            "context": 500000,
            "input": 372000,
            "output": 128000
          },
          "options": {
            "store": false
          },
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            }
          }
        },
        "gpt-6-luna": {
          "name": "GPT 6 Luna",
          "limit": {
            "context": 500000,
            "input": 372000,
            "output": 128000
          },
          "options": {
            "store": false
          },
          "variants": {
            "max": {
              "reasoningEffort": "max"
            }
          }
        }
      }
    },
    "anthropic-newapi": {
      "npm": "@ai-sdk/anthropic",
      "options": {
        "baseURL": "https://<YOUR_GATEWAY_HOST>/v1",
        "apiKey": "<YOUR_NEWAPI_API_KEY>"
      },
      "models": {
        "minimax-latest": {
          "name": "minimax latest",
          "limit": {
            "context": 1000000,
            "input": 900000,
            "output": 100000
          },
          "variants": {
            "low": {
              "thinking": {
                "type": "adaptive"
              },
              "effort": "low"
            },
            "max": {
              "thinking": {
                "type": "adaptive",
                "display": "summarized"
              },
              "effort": "max"
            }
          }
        },
        "kimi-latest": {
          "name": "kimi latest",
          "limit": {
            "context": 500000,
            "input": 372000,
            "output": 128000
          },
          "variants": {
            "low": {
              "thinking": {
                "type": "adaptive"
              },
              "effort": "low"
            },
            "max": {
              "thinking": {
                "type": "adaptive",
                "display": "summarized"
              },
              "effort": "max"
            }
          }
        },
        "deepseek-flash": {
          "name": "deepseek flash",
          "limit": {
            "context": 500000,
            "input": 372000,
            "output": 128000
          },
          "variants": {
            "low": {
              "thinking": {
                "type": "enabled",
                "budgetTokens": 8000
              },
              "effort": "low"
            },
            "high": {
              "thinking": {
                "type": "enabled",
                "display": "summarized",
                "budgetTokens": 16000
              },
              "effort": "high"
            },
            "max": {
              "thinking": {
                "type": "enabled",
                "display": "summarized",
                "budgetTokens": 32000
              },
              "effort": "max"
            }
          }
        },
        "grok-4.7": {
          "name": "Grok 4.7",
          "limit": {
            "context": 500000,
            "input": 372000,
            "output": 128000
          },
          "variants": {
            "low": {
              "thinking": {
                "type": "enabled",
                "budgetTokens": 8000
              },
              "effort": "low"
            },
            "high": {
              "thinking": {
                "type": "enabled",
                "display": "summarized",
                "budgetTokens": 16000
              },
              "effort": "high"
            },
            "max": {
              "thinking": {
                "type": "enabled",
                "display": "summarized",
                "budgetTokens": 32000
              },
              "effort": "max"
            }
          }
        }
      }
    },
    "zhipuai-coding-plan": {
      "models": {
        "glm-4.6v": {
          "limit": {
            "context": 500000,
            "output": 32768
          }
        },
        "glm-5.3": {
          "limit": {
            "context": 500000,
            "output": 131072
          }
        },
        "glm-5.3-flash": {
          "limit": {
            "context": 500000,
            "output": 131072
          }
        },
        "glm-5.3-highspeed": {
          "limit": {
            "context": 500000,
            "output": 131072
          }
        }
      }
    },
    "kimi-code-plan-cn": {
      "models": {
        "k3": {
          "limit": {
            "context": 500000,
            "output": 131072
          }
        },
        "k3-256k": {
          "limit": {
            "context": 500000,
            "output": 131072
          }
        },
        "kimi-for-coding": {
          "limit": {
            "context": 500000,
            "output": 32768
          }
        },
        "kimi-for-coding-highspeed": {
          "limit": {
            "context": 500000,
            "output": 32768
          }
        }
      }
    }
  },
  "agent": {
    "explore": {
      "model": "anthropic-newapi/deepseek-flash",
      "tools": {
        "read": true,
        "grep": true,
        "glob": true,
        "write": false,
        "edit": false
      }
    },
    "general": {
      "model": "anthropic-newapi/deepseek-flash",
      "tools": {
        "read": true,
        "grep": true,
        "glob": true,
        "write": true,
        "edit": true
      }
    }
  },
  "mcp": {
    "web": {
      "type": "remote",
      "url": "https://<YOUR_MCPHUB_HOST>/mcp/web"
    }
  },
  "snapshot": false,
  "plugin": [
    "@cortexkit/opencode-magic-context@latest",
    "@dietrichgebert/ponytail",
    "./plugins/claude-mem-wrapper.js"
  ]
}
